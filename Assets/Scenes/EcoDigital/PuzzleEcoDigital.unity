  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 369186660}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bad7dd4f9fcb85441a1b977d6a8d7507, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  alvoTMP: {fileID: 795788035}
  animator: {fileID: 1693258620}
  animatorLayerIndex: 0
  iniciarNoInicio: 1
  stateInicialOverride: 
  autoStartOnStateEnter: 1
  reiniciarAoReentrar: 0
  modoTempo: 1
  duracaoTotalPadrao: 6
  caracteresPorSegundo: 10
  duracaoFadeEntreLinhas: 0.35
  pausaAposDigitar: 1
  fazerFadeNaUltimaLinha: 0
  scriptsPorAnimacao:
  - stateName: CameraInicial
    linhas:
    - "Tantas notifica\xE7\xF5es ao meu redor..."
    - "Tantas pessoas que eu nem conhe\xE7o."
    - Tantas coisas acontecendo ao mesmo tempo.
    - "E mesmo assim, tudo parece t\xE3o distante."
    - Por que me sinto sozinho no meio de tanta gente?
    duracaoTotalOverride: 0
  - stateName: CameraJogo1
    linhas:
    - "Vejo sorrisos que parecem t\xE3o reais..."
    - Vejo vidas perfeitas passando na minha tela.
    - Cada postagem parece um mundo melhor do que o meu.
    - "E eu me pergunto se estou ficando para tr\xE1s."
    - "Ser\xE1 que s\xF3 eu me sinto assim?"
    duracaoTotalOverride: 0
  - stateName: CameraJogo3
    linhas:
    - Talvez todo mundo se sinta assim em algum momento...
    - "Talvez ningu\xE9m seja t\xE3o perfeito quanto parece online."
    - "Mas agora, aqui, me sinto perdido nesse sil\xEAncio digital."
    - "Como se eu fosse o \xFAnico sem um lugar nesse palco virtual."
    - "E \xE9 aqui que tudo come\xE7a..."
    duracaoTotalOverride: 0
  - stateName: CameraJogo6
    linhas:
    - "Cuidado com as notifica\xE7\xF5es"
    - "Elas s\xE3o gatilhos"
    - Melhor se esquivar delas
    - Prepare-se
    - Agora...
    duracaoTotalOverride: 0
  OnNarracaoIniciada:
    m_PersistentCalls:
      m_Calls: []
  OnNarracaoConcluida:
    m_PersistentCalls:
      m_Calls: []
  ecoGameManager: {fileID: 1929319653}
  stateParaAbrirPainel: CameraJogo3
